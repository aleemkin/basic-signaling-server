{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "signaling-server",
	"main": "src/index.ts",
	"compatibility_date": "2024-04-01",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "signaling-db",
			"database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
		}
	],
	"triggers": {
		"crons": ["0 0 * * *"]
	}
}
